<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NuGet 包元数据 -->
    <PackageId>WPF.Web</PackageId>
    <Version>1.0.0</Version>
    <Authors>LiYe</Authors>
    <Description>WPF + WebView2 桌面应用外壳模板：无边框窗口样式、WebView2 安全配置与前端桥接（SmartInvoker），通过 WebShellOptions 配置。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
