<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:shell="clr-namespace:WPF.Web">

    <!-- 图标字体（打包内资源，pack URI 引用） -->
    <FontFamily x:Key="ShellIconFont">pack://application:,,,/WPF.Web;component/Assets/iconfont.ttf#iconfont</FontFamily>

    <!-- 顶栏窗口按钮 -->
    <Style x:Key="ShellWindowButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ShellIconFont}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Background" Value="#202020" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#444444" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮（悬停变红） -->
    <Style x:Key="ShellWindowCloseButton" TargetType="Button" BasedOn="{StaticResource ShellWindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Red" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 外壳窗口默认样式：无边框 + 顶栏 + WebView2 内容区 -->
    <Style TargetType="{x:Type shell:ShellWindowBase}">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" UseAeroCaptionButtons="False"
                              GlassFrameThickness="0 40 0 0" NonClientFrameEdges="Left,Bottom,Right" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shell:ShellWindowBase}">
                    <AdornerDecorator>
                        <Grid x:Name="grid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#202020">
                                <DockPanel>
                                    <StackPanel Margin="0,0,4,0" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image VerticalAlignment="Center" Margin="12,0,0,0" Width="18"
                                               Source="{Binding Path=Icon, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}" />
                                        <Label FontWeight="Medium" Margin="4,0,0,0"
                                               Content="{Binding Path=Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                               VerticalAlignment="Center" Foreground="#A2A7AE" />
                                    </StackPanel>
                                    <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,4,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Name="min" Style="{StaticResource ShellWindowButton}" Content="&#xe65a;" />
                                        <Button Name="max" Style="{StaticResource ShellWindowButton}" Content="&#xe65d;" />
                                        <Button Name="close" Style="{StaticResource ShellWindowCloseButton}" Content="&#xe660;" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                            <Grid Grid.Row="1" Background="#272727">
                                <wv2:WebView2 Name="Web" DefaultBackgroundColor="#272727" Margin="4,0,4,4" />
                            </Grid>
                        </Grid>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="grid" Property="Margin" Value="8" />
                            <Setter TargetName="max" Property="Content">
                                <Setter.Value>
                                    <TextBlock Text="&#xe692;" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
